# Segredos das Edge Functions — configure com `supabase secrets set --env-file supabase/functions/.env`
# (NUNCA vão para o app). SUPABASE_URL, SUPABASE_ANON_KEY e SUPABASE_SERVICE_ROLE_KEY já existem.

# Pagamentos: mock | asaas | mercadopago
PAYMENT_PROVIDER=mock
ASAAS_API_URL=https://sandbox.asaas.com/api/v3
ASAAS_API_KEY=
ASAAS_CLIENTE_DOACOES=
ASAAS_WEBHOOK_TOKEN=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_EMAIL_PADRAO=doacoes@agora.comunidade.br

# Push (opcional, recomendado com "Enhanced push security" no Expo)
EXPO_ACCESS_TOKEN=

# Blockchain (Base Sepolia por padrão)
AGORA_RPC_URL=https://sepolia.base.org
# Chave do backend: PUBLICADOR_ROLE no Distribuidor + EMISSOR_ROLE no SBT; paga o gas do relayer.
# Use uma carteira dedicada, com pouco saldo, e troque-a se vazar.
AGORA_BACKEND_PK=
