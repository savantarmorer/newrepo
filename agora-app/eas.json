{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_REDE": "base-sepolia" }
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": { "EXPO_PUBLIC_REDE": "base-sepolia", "EXPO_PUBLIC_LOGIN_SENHA": "true" }
    },
    "production": {
      "autoIncrement": true,
      "env": { "EXPO_PUBLIC_REDE": "base-sepolia", "EXPO_PUBLIC_LOGIN_SENHA": "false" }
    }
  },
  "submit": {
    "production": {}
  }
}
