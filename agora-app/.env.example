# ── App (público: vai embutido no bundle — NUNCA coloque segredos aqui) ──────────
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=cole-a-anon-key-do-supabase
# Carteira embutida + paymaster (thirdweb → Dashboard → Settings → API Keys → Client ID)
EXPO_PUBLIC_THIRDWEB_CLIENT_ID=
# base-sepolia | base | polygon-amoy | polygon
EXPO_PUBLIC_REDE=base-sepolia
# Página web opcional para exportar a chave da carteira embutida
EXPO_PUBLIC_URL_EXPORTAR_CHAVE=
# Login por senha (contas de teste do seed). Desligue em produção.
EXPO_PUBLIC_LOGIN_SENHA=true
