# Copie para `.env` na raiz do repositório (não commitar valores reais).
# O servidor carrega automaticamente com `import 'dotenv/config'`.

# Opção simples (Resend): https://resend.com — domínio verificado ou e-mail de testes da conta
RESEND_API_KEY=
CIVIC_MAIL_FROM="Participação cívica <onboarding@resend.dev>"

# Alternativa: SMTP tradicional (preencha tudo; RESEND tem prioridade se RESEND_API_KEY estiver definida)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=0
# SMTP_USER=
# SMTP_PASS=
# CIVIC_MAIL_FROM="Participação <noreply@seudominio.com.br>"

PORT=3000

# ─────────────────────────────────────────────────────────────────────────────
# GOOGLE DRIVE — Biblioteca de Documentos
# Obtenha as credenciais em: https://console.cloud.google.com
# 1. Crie um projeto → Ative a "Google Drive API"
# 2a. (Pastas pública) Crie uma API Key e cole abaixo:
GOOGLE_API_KEY=
# 2b. (Service Account para pastas privadas) Crie uma Service Account,
#     baixe o JSON e configure as variáveis abaixo:
# GOOGLE_CLIENT_EMAIL=nome@projeto.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# Ou aponte para o arquivo JSON da Service Account:
# GOOGLE_SERVICE_ACCOUNT_JSON=./credentials/service-account.json

# IDs das pastas do Drive (configure os seus):
DRIVE_FOLDER_1=1EEi7bB3L2TIshhTOI-HJzQ4mgQ8F2k5i
DRIVE_FOLDER_2=18bq6fy8-n8IP8rhYRjXLNdvn7rrhR27Q
DRIVE_FOLDER_3=1zG4yx8B2S1mh7WiFcquCdMGJH_5y6f52

# Cache do indexador (em minutos). Padrão: 10
# DRIVE_CACHE_MINUTES=10

