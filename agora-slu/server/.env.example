# ── Supabase (mesmo projeto do AMOQ) ─────────────────────────────────
SUPABASE_URL=https://fveslvzjjixzpwiqcydz.supabase.co
SUPABASE_SERVICE_KEY=cole_aqui_a_service_role_key_do_dashboard

# ── Discord — criados no Discord Developer Portal (ver SETUP_INTEGRACOES.md) ─
DISCORD_BOT_TOKEN=cole_aqui_o_token_do_bot
DISCORD_GUILD_ID=cole_aqui_o_id_do_servidor_agora

# Mapeamento opcional de nome de cargo do Discord -> grau da Ágora (0-3).
# Se omitido, o server tenta casar pelo nome (Neófito/Adepto/Mestre da Obra/Conselheiro).
DISCORD_ROLE_GRAU_MAP={"Conselheiro":3,"Mestre da Obra":2,"Adepto":1,"Neófito":0}

# Canal público do Discord usado na prévia de mensagens de discord.html.
# Copie o ID do canal (botão direito > Copiar ID do Canal, com Modo Desenvolvedor ativo).
# Requer a "Message Content Intent" ativada em Discord Developer Portal > Bot.
# Deixe em branco para desativar a prévia de mensagens (o widget de membros continua funcionando).
DISCORD_PREVIEW_CHANNEL_ID=

# De quantos em quantos minutos o server sincroniza automaticamente os
# Scheduled Events do Discord para a tabela agora_discord_events.
DISCORD_EVENTS_SYNC_MINUTES=10

# Canal onde o bot posta anúncios cerimoniais automáticos (ex: quando alguém
# sobe de grau). Deixe em branco para desativar os anúncios.
DISCORD_ANNOUNCE_CHANNEL_ID=

PORT=4000

# Origem do front-end permitida no CORS (ajuste para o domínio real em produção)
ALLOWED_ORIGIN=http://localhost:5500
